{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuxPlayerX",
  "version": "2.0.10",
  "identifier": "com.eoliann.tuxplayerx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TuxPlayerX",
        "width": 1440,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: blob: data:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: blob: data: ws://localhost:* ws://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Video",
    "copyright": "Copyright © 2026 eoliann",
    "shortDescription": "Desktop streaming player",
    "longDescription": "TuxPlayerX is a desktop streaming player for user-provided M3U playlists and authorized MAC subscriptions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
