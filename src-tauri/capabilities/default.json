{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own commands, file pickers and the default core features.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-info",
    "allow-current-platform",
    "allow-list-subscriptions",
    "allow-save-subscription",
    "allow-delete-subscription",
    "allow-set-default-subscription",
    "allow-get-default-subscription",
    "allow-load-channels",
    "allow-resolve-channel-stream",
    "allow-refresh-subscription-info",
    "allow-load-epg-programs",
    "allow-load-epg-now",
    "allow-load-epg-grid",
    "allow-resolve-catchup-stream",
    "allow-vod-categories",
    "allow-vod-items",
    "allow-vod-details",
    "allow-series-info",
    "allow-resolve-vod-stream",
    "allow-export-backup",
    "allow-import-backup",
    "allow-list-favorites",
    "allow-toggle-favorite",
    "allow-list-recents",
    "allow-record-recent",
    "allow-get-settings",
    "allow-save-settings",
    "allow-open-url",
    "allow-reveal-backup",
    "allow-start-vlc-bridge",
    "allow-prepare-direct-stream",
    "allow-import-playlist-file",
    "allow-stop-vlc-bridge",
    "allow-open-external-player",
    "allow-open-detached-external-player",
    "allow-stop-external-player",
    "allow-shutdown-playback",
    "allow-open-pip-window",
    "allow-close-pip-window"
  ]
}
